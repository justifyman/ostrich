{
  "name": "ostrich-nostr-bot",
  "version": "0.1.0",
  "description": "A witty, fast, Nostr-native AI bot powered by Groq.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  },
  "keywords": [
    "nostr",
    "groq",
    "ai",
    "bot",
    "bitcoin"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "groq-sdk": "^1.2.1",
    "nostr-tools": "^2.23.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
